+//
+// kvz session state (LLAMA_STATE_SEQ_FLAGS_KVZ): each layer's K rows and V rows, exactly as the plain state would hold
+// them, are entropy-coded as one block (u64 size, then the block). The layer count carries a mark, so readers detect
+// the form and older readers stop at their layer-count check.
+//
+
+static constexpr uint32_t LLAMA_KVZ_MARK = 0x4b5a0000; // "KZ" in the high half of n_layer
+
+static kvz_layout llama_kvz_layout(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_K4C: return KVZ_PLANES2; // K4C keys are f16 rows in the session state
+        case GGML_TYPE_F32:  return KVZ_PLANES4;
+        case GGML_TYPE_Q8_0: return KVZ_Q8_0;
+        case GGML_TYPE_Q4_0: return KVZ_Q4_0;
+        default:             return KVZ_RAW;
+    }
+}
+
+// grow-only per-thread buffers: a fresh multi-MiB allocation per layer would fault in every page again
+static uint8_t * llama_kvz_buf(int i, size_t size) {
+    thread_local std::unique_ptr<uint8_t[]> buf[3];
+    thread_local size_t cap[3] = {0, 0, 0};
+    if (size > cap[i] || !buf[i]) {
+        buf[i].reset(new uint8_t[size ? size : 1]);
+        cap[i] = size;
+    }
+    return buf[i].get();
+}
+
+// collects the bytes one layer's rows would write
+class llama_io_write_rows : public llama_io_write_i {
+public:
+    llama_io_write_rows(uint8_t * dst, size_t size) : dst(dst), cap(size) {}
+
+    void write(const void * src, size_t size) override {
+        reserve(size);
+        memcpy(dst + n, src, size);
+        n += size;
+    }
+
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        reserve(size);
+        ggml_backend_tensor_get(tensor, dst + n, offset, size);
+        n += size;
+    }
+
+    size_t n_bytes() override {
+        return n;
+    }
+
+private:
+    void reserve(size_t size) const {
+        if (n + size > cap) {
+            throw std::runtime_error("kvz: layer state larger than its rows");
+        }
+    }
+
+    uint8_t * dst;
+    size_t    cap;
+    size_t    n = 0;
+};
+
+// replays decoded rows to one layer's reader
+class llama_io_read_rows : public llama_io_read_i {
+public:
+    llama_io_read_rows(const uint8_t * src, size_t size) : src(src), left(size) {}
+
+    void read(void * dst, size_t size) override {
+        take(size);
+        memcpy(dst, src, size);
+        src += size;
+    }
+
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        take(size);
+        ggml_backend_tensor_set(tensor, src, offset, size);
+        src += size;
+    }
+
+    size_t n_bytes() override {
+        return n;
+    }
+
+    bool done() const {
+        return left == 0;
+    }
+
+private:
+    void take(size_t size) {
+        if (size > left) {
+            throw std::runtime_error("kvz: layer state shorter than its rows");
+        }
+        left -= size;
+        n += size;
+    }
+
+    const uint8_t * src;
+    size_t left;
+    size_t n = 0;
+};
+
+static void llama_kvz_write(llama_io_write_i & io, ggml_type type, size_t rows, size_t row_size,
+                            const std::function<void(llama_io_write_i &)> & write_rows) {
+    const size_t raw = rows * row_size;
+    if (io.size_only()) {
+        static const uint8_t unread = 0;
+        io.write(&unread, sizeof(uint64_t) + kvz_bound(raw));
+        return;
+    }
+    uint8_t * src = llama_kvz_buf(0, raw);
+    llama_io_write_rows rw(src, raw);
+    write_rows(rw);
+    if (rw.n_bytes() != raw) {
+        throw std::runtime_error("kvz: layer state shorter than its rows");
+    }
+    uint8_t * dst = llama_kvz_buf(1, kvz_bound(raw));
+    const uint64_t size = kvz_encode(llama_kvz_layout(type), src, rows, row_size, dst, kvz_default_threads());
+    io.write(&size, sizeof(size));
+    io.write(dst, size);
+}
+
+static void llama_kvz_read(llama_io_read_i & io, size_t rows, size_t row_size, const std::function<void(llama_io_read_i &)> & read_rows) {
+    const size_t raw = rows * row_size;
+    uint64_t size;
+    io.read(&size, sizeof(size));
+    if (size > kvz_bound(raw)) {
+        throw std::runtime_error("kvz: block size out of range");
+    }
+    uint8_t * src = llama_kvz_buf(1, size);
+    io.read(src, size);
+    uint8_t * dst = llama_kvz_buf(2, raw);
+    if (!kvz_decode(src, size, dst, rows, row_size, kvz_default_threads())) {
+        throw std::runtime_error("kvz: corrupt KV block");
+    }
+    llama_io_read_rows rr(dst, raw);
+    read_rows(rr);
+    if (!rr.done()) {
+        throw std::runtime_error("kvz: layer state longer than its rows");
+    }
+}
+
+// one block of opaque bytes (k4c native group records), stored by kvz as KVZ_RAW
+static void llama_kvz_write_raw(llama_io_write_i & io, const uint8_t * data, size_t n) {
+    if (io.size_only()) {
+        static const uint8_t unread = 0;
+        io.write(&unread, sizeof(uint64_t) + kvz_bound(n));
+        return;
+    }
+    uint8_t * dst = llama_kvz_buf(1, kvz_bound(n));
+    const uint64_t size = kvz_encode(KVZ_RAW, data, 1, n, dst, 1);
+    io.write(&size, sizeof(size));
+    io.write(dst, size);
+}
+
+static void llama_kvz_read_raw(llama_io_read_i & io, uint8_t * data, size_t n) {
+    uint64_t size;
+    io.read(&size, sizeof(size));
+    if (size > kvz_bound(n)) {
+        throw std::runtime_error("kvz: block size out of range");
+    }
+    uint8_t * src = llama_kvz_buf(1, size);
+    io.read(src, size);
+    if (!kvz_decode(src, size, data, 1, n, 1)) {
+        throw std::runtime_error("kvz: corrupt KV block");
+    }
+}
