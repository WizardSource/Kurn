+static inline __m512i q8g_load2(const block_q8_0 * b) {
+    return _mm512_inserti64x4(_mm512_castsi256_si512(_mm256_loadu_si256((const __m256i *) b[0].qs)),
+                              _mm256_loadu_si256((const __m256i *) b[1].qs), 1);
