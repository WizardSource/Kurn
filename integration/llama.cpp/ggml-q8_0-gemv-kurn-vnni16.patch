+// kurn-generated Q8_0 decode GEMV on the vnni16 layout (kurn examples/q8_0_gemv_vnni16.kurn).
+// Weights are repacked lazily on first use and cached by data pointer (extra memory = Q8_0 weight size).
+#include <pthread.h>
+#include "kurn_q8_0_gemv.inc"
+#define KURN_CACHE_SLOTS 8192
+// The cache is keyed by data pointer + shape + a content signature (32 sampled
+// 8-byte words), re-checked on every lookup: a freed weight buffer can be reused
+// at the same address for different weights (model reload, tests), and a
+// pointer-only key would then serve a stale packed copy (found by
+// kurn/integration/llama.cpp/test_mul_mat_hook.c, buffer-reuse cases).
+typedef struct { const void * key; int64_t ne0, ne1; uint64_t sig; void * packed; } kurn_entry;
+static kurn_entry * kurn_cache[KURN_CACHE_SLOTS];
+static pthread_mutex_t kurn_cache_mu = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t kurn_signature(const struct ggml_tensor * t) {
+    const size_t n = ggml_nbytes(t) / 8;
+    const uint64_t * p = (const uint64_t *) t->data;
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ (uint64_t) t->ne[0] * 31 ^ (uint64_t) t->ne[1] * 131;
+    for (int i = 0; i < 32; i++) {
+        uint64_t v;
+        memcpy(&v, p + (n - 1) * (size_t) i / 31, 8);
+        h = (h ^ v) * 0x100000001B3ull;
+        h ^= h >> 29;
+    }
+    return h;
+}
+static void kurn_free_packed(void * pv) {
+    kurn_packed_t * pk = (kurn_packed_t *) pv;
+    free(pk->blk);
+    free(pk);
+}
+static void * kurn_get_packed(const struct ggml_tensor * t) {
+    const size_t h = ((uintptr_t) t->data >> 6) % KURN_CACHE_SLOTS;
+    const uint64_t sig = kurn_signature(t);
+    for (size_t i = 0; i < KURN_CACHE_SLOTS; i++) {
+        const kurn_entry * e = __atomic_load_n(&kurn_cache[(h + i) % KURN_CACHE_SLOTS], __ATOMIC_ACQUIRE);
+        if (e == NULL) break;
+        if (e->key == t->data) {
+            if (e->ne0 == t->ne[0] && e->ne1 == t->ne[1] && e->sig == sig) return e->packed;
+            break; // same address, different weights: repack under the lock
+        }
+    }
+    pthread_mutex_lock(&kurn_cache_mu);
+    void * res = NULL;
+    for (size_t i = 0; i < KURN_CACHE_SLOTS; i++) {
+        kurn_entry ** slot = &kurn_cache[(h + i) % KURN_CACHE_SLOTS];
+        kurn_entry * e = *slot;
+        if (e != NULL && e->key != t->data) continue;
+        if (e != NULL && e->ne0 == t->ne[0] && e->ne1 == t->ne[1] && e->sig == sig) { res = e->packed; break; }
+        if (getenv("GGML_KURN_VNNI16_VERBOSE")) fprintf(stderr, "kurn: repack %s [%lld x %lld]%s\n", t->name, (long long) t->ne[0], (long long) t->ne[1], e ? " (replacing stale entry)" : "");
+        kurn_entry * n = malloc(sizeof *n);
+        *n = (kurn_entry) { t->data, t->ne[0], t->ne[1], sig, kurn_kq8_gemv_prepare(t->data, t->ne[0], t->ne[1]) };
+        __atomic_store_n(slot, n, __ATOMIC_RELEASE);
+        if (e != NULL) { kurn_free_packed(e->packed); free(e); } // replaced weights: no thread still uses the old copy
+        res = n->packed;
+        break;
+    }
+    pthread_mutex_unlock(&kurn_cache_mu);
+    GGML_ASSERT(res != NULL && "kurn repack cache full");
+    return res;
+}
