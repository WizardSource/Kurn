+// K4C rows are quantized per channel over groups of GGML_K4C_GROUP rows: each thread updates whole groups.
+// The head dim comes from op_params[0] (set by llama.cpp's cpy_k).
+template <typename idx_t>
+static void ggml_compute_forward_set_rows_k4c(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const int64_t dk = ggml_get_op_params_i32(dst, 0);
+    const int64_t n_embd = dst->ne[0];
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dk > 0 && n_embd % dk == 0 && dk % 32 == 0);
+    GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1 && dst->ne[2] == 1 && dst->ne[3] == 1 && dst->ne[1] % GGML_K4C_GROUP == 0);
+    const int64_t n = src0->ne[1];
+    std::vector<std::pair<int64_t, int64_t>> mine; // (row, source row) of the groups this thread owns
+    for (int64_t i = 0; i < n; i++) {
+        const int64_t r = *(const idx_t *) ((const char *) src1->data + i*src1->nb[0]);
+        GGML_ASSERT(r >= 0 && r < dst->ne[1]);
+        if ((r / GGML_K4C_GROUP) % params->nth == params->ith) {
+            mine.emplace_back(r, i);
+        }
+    }
+    std::stable_sort(mine.begin(), mine.end(), [](const auto & a, const auto & b) { return a.first / GGML_K4C_GROUP < b.first / GGML_K4C_GROUP; });
+    for (size_t j = 0; j < mine.size();) {
+        const int64_t g = mine[j].first / GGML_K4C_GROUP;
+        const float * rows[GGML_K4C_GROUP] = {};
+        uint32_t set = 0;
+        for (; j < mine.size() && mine[j].first / GGML_K4C_GROUP == g; j++) {
+            const int r = (int) (mine[j].first % GGML_K4C_GROUP);
+            rows[r] = (const float *) ((const char *) src0->data + mine[j].second*src0->nb[1]);
+            set |= 1u << r;
+        }
+        ggml_k4c_update_group((char *) dst->data + g*GGML_K4C_GROUP*dst->nb[1], n_embd/dk, dk, set, rows, 0);
+    }
+}
