+// K4C rows: each thread reads whole groups (one exact-value lookup per group); head dim in op_params[0]
+static void ggml_compute_forward_get_rows_k4c(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const int64_t dk = ggml_get_op_params_i32(dst, 0);
+    const int64_t n_embd = src0->ne[0];
+    GGML_ASSERT(src1->type == GGML_TYPE_I32 && dst->type == GGML_TYPE_F32 && dk > 0 && n_embd % dk == 0);
+    GGML_ASSERT(src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[1] == 1 && src0->ne[1] % GGML_K4C_GROUP == 0);
+    std::vector<std::pair<int64_t, int64_t>> mine; // (row, destination row) of the groups this thread owns
+    for (int64_t i = 0; i < src1->ne[0]; i++) {
+        const int64_t r = *(const int32_t *) ((const char *) src1->data + i*src1->nb[0]);
+        GGML_ASSERT(r >= 0 && r < src0->ne[1]);
+        if ((r / GGML_K4C_GROUP) % params->nth == params->ith) {
+            mine.emplace_back(r, i);
+        }
+    }
+    std::stable_sort(mine.begin(), mine.end(), [](const auto & a, const auto & b) { return a.first / GGML_K4C_GROUP < b.first / GGML_K4C_GROUP; });
+    std::vector<float> rows((size_t) GGML_K4C_GROUP * n_embd);
+    for (size_t j = 0; j < mine.size();) {
+        const int64_t g = mine[j].first / GGML_K4C_GROUP;
+        uint32_t want = 0;
+        for (size_t k = j; k < mine.size() && mine[k].first / GGML_K4C_GROUP == g; k++) {
+            want |= 1u << (mine[k].first % GGML_K4C_GROUP);
+        }
+        ggml_k4c_get_group_src((const char *) src0->data + g*GGML_K4C_GROUP*src0->nb[1], n_embd/dk, dk, want, rows.data());
+        for (; j < mine.size() && mine[j].first / GGML_K4C_GROUP == g; j++) {
+            memcpy((char *) dst->data + mine[j].second*dst->nb[1], rows.data() + (mine[j].first % GGML_K4C_GROUP) * n_embd, sizeof(float) * n_embd);
+        }
+    }
+}
