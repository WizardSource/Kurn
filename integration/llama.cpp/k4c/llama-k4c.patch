+// K4C keys in session state: f16 rows (state_write_k4c), re-quantized into the destination groups on read.
+void llama_kv_cache::state_write_k4c(llama_io_write_i & io, ggml_tensor * k, uint32_t il, const cell_ranges_t & cr) const {
+    const int64_t dk = hparams.n_embd_head_k(il), n_embd = hparams.n_embd_k_gqa(il);
+    const size_t gbytes = GGML_K4C_GROUP * ggml_row_size(k->type, n_embd);
+    const bool host = k->buffer && ggml_backend_buffer_is_host(k->buffer); // in place: the codec keys its exact values by address
+    std::vector<uint8_t> grp(gbytes);
+    std::vector<float> f((size_t) GGML_K4C_GROUP * n_embd);
+    std::vector<ggml_fp16_t> h(n_embd);
+    int64_t g_cur = -1;
+    for (const auto & range : cr.data) {
+        for (uint32_t i = range.first; i < range.second; ++i) {
+            const int64_t g = i / GGML_K4C_GROUP;
+            if (g != g_cur) {
+                if (!host) {
+                    ggml_backend_tensor_get(k, grp.data(), g * gbytes, gbytes);
+                }
+                ggml_k4c_get_group_src(host ? (const char *) k->data + g * gbytes : (const char *) grp.data(), n_embd / dk, dk, 0xFFFFFFFFu, f.data());
+                g_cur = g;
+            }
+            ggml_fp32_to_fp16_row(f.data() + (size_t) (i % GGML_K4C_GROUP) * n_embd, h.data(), n_embd);
+            io.write(h.data(), h.size() * sizeof(ggml_fp16_t));
+        }
+    }
+}
+
+// Native K4C session state: one record per group the saved cells touch, in cell order:
+//   u32 kind, u32 mask (in-group offsets of the saved cells), then
+//   kind 0: the group's bytes (n_head * dk * 20): the group holds only saved rows and is either complete or has no exact
+//           values left, so restoring it at the same offsets is byte-exact;
+//   kind 1: popcount(mask) f16 rows: the codec's exact values for a partial group (re-encoding them reproduces the bytes
+//           and the exact-value table, so later appends continue as if never saved), or the rows of a group shared
+//           with cells that are not saved.
+// Restored at other offsets, or into a group that holds other rows, a record is re-encoded from its values.
+std::vector<uint8_t> llama_kv_cache::state_write_k4c_native(ggml_tensor * k, uint32_t il, const cell_ranges_t & cr) const {
+    const int64_t dk = hparams.n_embd_head_k(il), n_embd = hparams.n_embd_k_gqa(il), n_head = n_embd / dk;
+    const size_t gbytes = GGML_K4C_GROUP * ggml_row_size(k->type, n_embd);
+    const bool host = k->buffer && ggml_backend_buffer_is_host(k->buffer);
+    std::vector<uint8_t> out, grp(host ? 0 : gbytes);
+    std::vector<ggml_fp16_t> ex((size_t) GGML_K4C_GROUP * n_embd);
+    std::vector<float> f((size_t) GGML_K4C_GROUP * n_embd);
+    auto put = [&](const void * p, size_t n) { out.insert(out.end(), (const uint8_t *) p, (const uint8_t *) p + n); };
+    int64_t g_cur = -1;
+    uint32_t mask = 0;
+    auto flush = [&]() {
+        if (g_cur < 0 || !mask) {
+            return;
+        }
+        const uint8_t * blk;
+        if (host) {
+            blk = (const uint8_t *) k->data + g_cur * gbytes;
+        } else {
+            ggml_backend_tensor_get(k, grp.data(), g_cur * gbytes, gbytes);
+            blk = grp.data();
+        }
+        const uint32_t valid = ggml_k4c_group_valid(blk, n_head, dk);
+        const uint32_t exact = ggml_k4c_group_exact_f16(blk, n_head, dk, mask, ex.data());
+        const bool own = (valid & ~mask) == 0, full = valid == 0xFFFFFFFFu;
+        const uint32_t kind = own && (full || exact != mask) ? 0 : 1;
+        put(&kind, 4);
+        put(&mask, 4);
+        if (kind == 0) {
+            put(blk, gbytes);
+        } else {
+            if (exact != mask) { // shared group: the stored values of the rows without exact ones
+                ggml_k4c_get_group_src(blk, n_head, dk, mask & ~exact, f.data());
+                for (int r = 0; r < GGML_K4C_GROUP; r++) {
+                    if ((mask & ~exact) >> r & 1) {
+                        ggml_fp32_to_fp16_row(f.data() + (size_t) r * n_embd, ex.data() + (size_t) r * n_embd, n_embd);
+                    }
+                }
+            }
+            for (int r = 0; r < GGML_K4C_GROUP; r++) {
+                if (mask >> r & 1) {
+                    put(ex.data() + (size_t) r * n_embd, sizeof(ggml_fp16_t) * n_embd);
+                }
+            }
+        }
+        mask = 0;
+    };
+    for (const auto & range : cr.data) {
+        for (uint32_t i = range.first; i < range.second; ++i) {
+            if ((int64_t) (i / GGML_K4C_GROUP) != g_cur) {
+                flush();
+                g_cur = i / GGML_K4C_GROUP;
+            }
+            mask |= 1u << (i % GGML_K4C_GROUP);
+        }
+    }
+    flush();
+    return out;
+}
+
+bool llama_kv_cache::state_read_k4c_native(const std::vector<uint8_t> & buf, ggml_tensor * k, uint32_t il, const std::vector<uint32_t> & idxs, uint32_t cell_count) {
+    const int64_t dk = hparams.n_embd_head_k(il), n_embd = hparams.n_embd_k_gqa(il), n_head = n_embd / dk;
+    const size_t gbytes = GGML_K4C_GROUP * ggml_row_size(k->type, n_embd);
+    const bool host = k->buffer && ggml_backend_buffer_is_host(k->buffer);
+    std::vector<uint8_t> grp(gbytes);
+    std::vector<float> f((size_t) GGML_K4C_GROUP * n_embd);
+    // group g of the destination, read-modify-write through `fn`
+    auto with_group = [&](int64_t g, const std::function<void(uint8_t *)> & fn) {
+        if (host) {
+            fn((uint8_t *) k->data + g * gbytes);
+            return;
+        }
+        ggml_backend_tensor_get(k, grp.data(), g * gbytes, gbytes);
+        fn(grp.data());
+        ggml_backend_tensor_set(k, grp.data(), g * gbytes, gbytes);
+    };
+    // rows (f32, [32][n_embd], offsets of mask) of one record into the destination cells idxs[j0 ..]
+    auto write_rows = [&](uint32_t mask, uint32_t j0) {
+        uint32_t j = j0;
+        int r = 0;
+        while (r < GGML_K4C_GROUP && (mask >> r)) {
+            const int64_t g = idxs[j] / GGML_K4C_GROUP;
+            const float * rows[GGML_K4C_GROUP] = {};
+            uint32_t set = 0;
+            for (; r < GGML_K4C_GROUP && (mask >> r); r++) {
+                if (!(mask >> r & 1)) {
+                    continue;
+                }
+                if ((int64_t) (idxs[j] / GGML_K4C_GROUP) != g) {
+                    break;
+                }
+                rows[idxs[j] % GGML_K4C_GROUP] = f.data() + (size_t) r * n_embd;
+                set |= 1u << (idxs[j] % GGML_K4C_GROUP);
+                j++;
+            }
+            with_group(g, [&](uint8_t * blk) { ggml_k4c_update_group(blk, n_head, dk, set, rows, 0); });
+        }
+    };
+    size_t off = 0;
+    uint32_t j = 0;
+    while (off < buf.size()) {
+        uint32_t kind, mask;
+        if (off + 8 > buf.size()) {
+            return false;
+        }
+        memcpy(&kind, buf.data() + off, 4);
+        memcpy(&mask, buf.data() + off + 4, 4);
+        off += 8;
+        uint32_t n = 0;
+        for (int r = 0; r < GGML_K4C_GROUP; r++) {
+            n += mask >> r & 1;
+        }
+        const size_t payload = kind == 0 ? gbytes : (size_t) n * n_embd * sizeof(ggml_fp16_t);
+        if (!mask || kind > 1 || j + n > cell_count || off + payload > buf.size()) {
+            return false;
+        }
+        const uint8_t * p = buf.data() + off;
+        // same in-group offsets in one destination group?
+        bool aligned = true;
+        for (uint32_t r = 0, jj = j; r < GGML_K4C_GROUP; r++) {
+            if (mask >> r & 1) {
+                aligned &= idxs[jj] % GGML_K4C_GROUP == r && idxs[jj] / GGML_K4C_GROUP == idxs[j] / GGML_K4C_GROUP;
+                jj++;
+            }
+        }
+        const int64_t g = idxs[j] / GGML_K4C_GROUP;
+        if (kind == 0) {
+            bool copied = false;
+            if (aligned) {
+                with_group(g, [&](uint8_t * blk) {
+                    if ((ggml_k4c_group_valid(blk, n_head, dk) & ~mask) == 0) { // nothing else lives there: the bytes as saved
+                        memcpy(blk, p, gbytes);
+                        copied = true;
+                    }
+                });
+            }
+            if (!copied) {
+                for (int r = 0; r < GGML_K4C_GROUP; r++) {
+                    if (mask >> r & 1) {
+                        ggml_k4c_get_row(p, n_head, dk, r, f.data() + (size_t) r * n_embd);
+                    }
+                }
+                write_rows(mask, j);
+            }
+        } else {
+            for (int r = 0, i = 0; r < GGML_K4C_GROUP; r++) {
+                if (mask >> r & 1) {
+                    ggml_fp16_to_fp32_row((const ggml_fp16_t *) p + (size_t) i++ * n_embd, f.data() + (size_t) r * n_embd, n_embd);
+                }
+            }
+            write_rows(mask, j);
+        }
+        off += payload;
+        j += n;
+    }
+    return j == cell_count;
+}
+
+void llama_kv_cache::state_read_k4c(llama_io_read_i & io, ggml_tensor * k, uint32_t il, const std::vector<uint32_t> & idxs, uint32_t cell_count) {
+    const int64_t dk = hparams.n_embd_head_k(il), n_embd = hparams.n_embd_k_gqa(il);
+    const size_t gbytes = GGML_K4C_GROUP * ggml_row_size(k->type, n_embd);
+    std::vector<float> f((size_t) cell_count * n_embd);
+    {
+        std::vector<ggml_fp16_t> h((size_t) cell_count * n_embd);
+        io.read(h.data(), h.size() * sizeof(ggml_fp16_t));
+        ggml_fp16_to_fp32_row(h.data(), f.data(), (int64_t) h.size());
+    }
+    std::vector<uint8_t> grp(gbytes);
+    for (uint32_t j = 0; j < cell_count;) {
+        const int64_t g = idxs[j] / GGML_K4C_GROUP;
+        const float * rows[GGML_K4C_GROUP] = {};
+        uint32_t set = 0;
+        for (; j < cell_count && idxs[j] / GGML_K4C_GROUP == g; ++j) {
+            rows[idxs[j] % GGML_K4C_GROUP] = f.data() + (size_t) j * n_embd;
+            set |= 1u << (idxs[j] % GGML_K4C_GROUP);
+        }
+        if (k->buffer && ggml_backend_buffer_is_host(k->buffer)) {
+            ggml_k4c_update_group((char *) k->data + g * gbytes, n_embd / dk, dk, set, rows, 0);
+            continue;
+        }
+        ggml_backend_tensor_get(k, grp.data(), g * gbytes, gbytes);
+        ggml_k4c_update_group(grp.data(), n_embd / dk, dk, set, rows, 0);
+        ggml_backend_tensor_set(k, grp.data(), g * gbytes, gbytes);
+    }
+}
+
+void llama_kv_cache::k4c_clear_cells(ggml_tensor * k, uint32_t il, const std::vector<uint32_t> & idxs) {
+    const int64_t dk = hparams.n_embd_head_k(il), n_embd = hparams.n_embd_k_gqa(il);
+    const size_t gbytes = GGML_K4C_GROUP * ggml_row_size(k->type, n_embd);
+    const bool host = k->buffer && ggml_backend_buffer_is_host(k->buffer);
+    std::vector<uint8_t> grp(host ? 0 : gbytes);
+    for (size_t j = 0; j < idxs.size();) {
+        const int64_t g = idxs[j] / GGML_K4C_GROUP;
+        uint32_t clear = 0;
+        for (; j < idxs.size() && idxs[j] / GGML_K4C_GROUP == g; ++j) {
+            clear |= 1u << (idxs[j] % GGML_K4C_GROUP);
+        }
+        if (host) {
+            ggml_k4c_update_group((char *) k->data + g * gbytes, n_embd / dk, dk, 0, nullptr, clear);
+            continue;
+        }
+        ggml_backend_tensor_get(k, grp.data(), g * gbytes, gbytes);
+        ggml_k4c_update_group(grp.data(), n_embd / dk, dk, 0, nullptr, clear);
+        ggml_backend_tensor_set(k, grp.data(), g * gbytes, gbytes);
+    }
+}
