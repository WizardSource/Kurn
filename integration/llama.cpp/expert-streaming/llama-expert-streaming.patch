+// kurn expert streaming: LLAMA_EXPERT_STREAM=<file.kxs> (from llama-kurn-xs-convert), slab cache size
+// LLAMA_EXPERT_CACHE_MB (default 4096). Only the first model loaded with it set is streamed.
+static void llama_kurn_xs_setup(const std::string & fname, llama_model_loader & ml) {
+    const char * path = getenv("LLAMA_EXPERT_STREAM");
+    if (!path || !*path) {
+        return;
+    }
+    typedef bool (*open_t)(const char *, const char *, size_t);
+    typedef bool (*is_streamed_t)(const char *);
+    static std::string opened;
+    ggml_backend_dev_t dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto xs_open = reg ? (open_t) ggml_backend_reg_get_proc_address(reg, "ggml_kurn_xs_open") : nullptr;
+    auto xs_is_streamed = reg ? (is_streamed_t) ggml_backend_reg_get_proc_address(reg, "ggml_kurn_xs_is_streamed") : nullptr;
+    if (!xs_open || !xs_is_streamed) {
+        throw std::runtime_error("LLAMA_EXPERT_STREAM is set but this build has no kurn expert streaming");
+    }
+    if (opened.empty()) {
+        const char * mb = getenv("LLAMA_EXPERT_CACHE_MB");
+        const size_t cache = (size_t) (mb && *mb ? atoll(mb) : 4096) << 20;
+        if (!xs_open(path, fname.c_str(), cache)) {
+            throw std::runtime_error(std::string("cannot use expert file ") + path);
+        }
+        opened = fname;
+    } else if (opened != fname) {
+        return;
+    }
+    ml.xs.is_streamed = xs_is_streamed;
+}
