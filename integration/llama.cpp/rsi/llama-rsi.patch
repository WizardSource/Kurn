+// kurn position-keyed sampling: a drop-in for the `dist` sampler whose uniform for each token is a hash of
+// (seed, position) instead of the next draw of a sequential stream. The position is the number of tokens
+// the sampler has accepted since its last reset; the server accepts every prompt token after a reset, so
+// for text prompts it equals the token's position in the sequence. A token's draw therefore does not
+// depend on how the request was split, batched, speculated or resumed from a cached prefix.
+struct kurn_dist_pos {
+    uint32_t seed;
+    uint64_t pos;
+};
+
+static uint64_t kurn_mix64(uint64_t x) {
+    x += 0x9e3779b97f4a7c15ULL;
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    return x ^ (x >> 31);
+}
+
+double kurn_position_uniform(uint32_t seed, uint64_t pos) {
+    return (double) (kurn_mix64(kurn_mix64(seed) ^ pos) >> 11) * 0x1.0p-53;
+}
+
+static const char * kurn_dist_pos_name(const struct llama_sampler * /*smpl*/) {
+    return "kurn-dist-pos";
+}
+
+static void kurn_dist_pos_accept(struct llama_sampler * smpl, llama_token /*token*/) {
+    ((kurn_dist_pos *) smpl->ctx)->pos++;
+}
+
+static void kurn_dist_pos_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    const auto * ctx = (const kurn_dist_pos *) smpl->ctx;
+    if (cur_p->size == 0) {
+        cur_p->selected = -1;
+        return;
+    }
+    cur_p->selected = 0;
+    if (cur_p->size == 1) {
+        cur_p->data[0].p = 1.0f;
+        return;
+    }
+    float max_l = cur_p->data[0].logit;
+    for (size_t i = 1; i < cur_p->size; ++i) {
+        max_l = std::max(max_l, cur_p->data[i].logit);
+    }
+    double sum_cum = 0.0;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const float p = expf(cur_p->data[i].logit - max_l);
+        cur_p->data[i].p = p;
+        sum_cum += p;
+    }
+    const double sum_tgt = sum_cum * kurn_position_uniform(ctx->seed, ctx->pos);
+    double sum_run = 0.0;
+    bool found = false;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (!found) {
+            sum_run += cur_p->data[i].p;
+            if (sum_run >= sum_tgt) {
+                cur_p->selected = i;
+                found = true;
+            }
+        }
+        cur_p->data[i].p /= sum_cum;
+    }
+    if (!found) {
+        cur_p->selected = cur_p->size - 1;
+    }
+}
+
+static void kurn_dist_pos_reset(struct llama_sampler * smpl) {
+    ((kurn_dist_pos *) smpl->ctx)->pos = 0;
+}
+
+static struct llama_sampler * kurn_dist_pos_clone(const struct llama_sampler * smpl);
+
+static void kurn_dist_pos_free(struct llama_sampler * smpl) {
+    delete (kurn_dist_pos *) smpl->ctx;
+}
+
+static void kurn_dist_pos_copy_state(const struct llama_sampler * src, struct llama_sampler * dst) {
+    *(kurn_dist_pos *) dst->ctx = *(const kurn_dist_pos *) src->ctx;
+}
+
+static struct llama_sampler_i kurn_dist_pos_i = {
+    /* .name              = */ kurn_dist_pos_name,
+    /* .accept            = */ kurn_dist_pos_accept,
+    /* .apply             = */ kurn_dist_pos_apply,
+    /* .reset             = */ kurn_dist_pos_reset,
+    /* .clone             = */ kurn_dist_pos_clone,
+    /* .free              = */ kurn_dist_pos_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ kurn_dist_pos_copy_state,
+};
+
+static struct llama_sampler * kurn_dist_pos_clone(const struct llama_sampler * smpl) {
+    return llama_sampler_init(&kurn_dist_pos_i, new kurn_dist_pos(*(const kurn_dist_pos *) smpl->ctx));
+}
+
+static struct llama_sampler * kurn_sampler_init_dist_pos(uint32_t seed) {
+    if (seed == LLAMA_DEFAULT_SEED) {
+        seed = std::random_device{}();
+    }
+    return llama_sampler_init(&kurn_dist_pos_i, new kurn_dist_pos{ seed, 0 });
+}
