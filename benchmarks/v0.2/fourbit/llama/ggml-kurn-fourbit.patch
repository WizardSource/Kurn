index 000000000..541c52555
--- /dev/null
+++ b/ggml/src/ggml-cpu/kurn_hook.h
@@ -0,0 +1,108 @@
+// kurn v0.2 multi-format hook for ggml-cpu's MUL_MAT (included by ggml-cpu.c on AVX-512 VNNI builds).
+// Enabled with GGML_KURN=1 (weights must be in the plain CPU buffer: --repack 0 / --no-repack).
+// Handles 2D, contiguous weights of the types in kurn_dispatch.h times 1..8 activation rows:
+// ne11 == 1 -> decode GEMV, 2..8 -> verify kernel with the same per-column arithmetic, so
+// results do not depend on how many tokens are decoded together.
+#pragma once
+#include "kurn_dispatch.h"
+#include <pthread.h>
+
+#define KURN_CACHE_SLOTS 8192
+// Packed copies are cached per (data pointer, packing kind), validated by shape + a content
+// signature on every lookup (a freed buffer can be reused at the same address for different
+// weights; a pointer-only key then serves stale data).
+typedef struct { const void * key; int kind; int64_t ne0, ne1; uint64_t sig; void * packed; } kurn_entry;
+static kurn_entry * kurn_cache[KURN_CACHE_SLOTS];
+static pthread_mutex_t kurn_cache_mu = PTHREAD_MUTEX_INITIALIZER;
+
+static uint64_t kurn_signature(const struct ggml_tensor * t) {
+    const size_t n = ggml_nbytes(t) / 8;
+    const uint64_t * p = (const uint64_t *) t->data;
+    uint64_t h = 0x9E3779B97F4A7C15ull ^ (uint64_t) t->ne[0] * 31 ^ (uint64_t) t->ne[1] * 131 ^ (uint64_t) t->type;
+    for (int i = 0; i < 32; i++) {
+        uint64_t v;
+        memcpy(&v, p + (n - 1) * (size_t) i / 31, 8);
+        h = (h ^ v) * 0x100000001B3ull;
+        h ^= h >> 29;
+    }
+    return h;
+}
+
+static void * kurn_get_packed(const struct ggml_tensor * t, int kind, kurn_prep_fn prep) {
+    const size_t h = (((uintptr_t) t->data >> 6) + (size_t) kind * 977) % KURN_CACHE_SLOTS;
+    const uint64_t sig = kurn_signature(t);
+    for (size_t i = 0; i < KURN_CACHE_SLOTS; i++) {
+        const kurn_entry * e = __atomic_load_n(&kurn_cache[(h + i) % KURN_CACHE_SLOTS], __ATOMIC_ACQUIRE);
+        if (e == NULL) break;
+        if (e->key == t->data && e->kind == kind) {
+            if (e->ne0 == t->ne[0] && e->ne1 == t->ne[1] && e->sig == sig) return e->packed;
+            break;
+        }
+    }
+    pthread_mutex_lock(&kurn_cache_mu);
+    void * res = NULL;
+    for (size_t i = 0; i < KURN_CACHE_SLOTS; i++) {
+        kurn_entry ** slot = &kurn_cache[(h + i) % KURN_CACHE_SLOTS];
+        kurn_entry * e = *slot;
+        if (e != NULL && (e->key != t->data || e->kind != kind)) continue;
+        if (e != NULL && e->ne0 == t->ne[0] && e->ne1 == t->ne[1] && e->sig == sig) { res = e->packed; break; }
+        if (getenv("GGML_KURN_VERBOSE")) fprintf(stderr, "kurn: repack %s [%lld x %lld] %s kind %d%s\n", t->name,
+                                                 (long long) t->ne[0], (long long) t->ne[1], ggml_type_name(t->type), kind,
+                                                 e ? " (replacing stale entry)" : "");
+        kurn_entry * n = malloc(sizeof *n);
+        *n = (kurn_entry) { t->data, kind, t->ne[0], t->ne[1], sig, prep(t->data, t->ne[0], t->ne[1]) };
+        __atomic_store_n(slot, n, __ATOMIC_RELEASE);
+        if (e != NULL) free(e); // the old packed buffer is leaked on purpose: generated layouts own their allocation
+        res = n->packed;
+        break;
+    }
+    pthread_mutex_unlock(&kurn_cache_mu);
+    GGML_ASSERT(res != NULL && "kurn repack cache full");
+    return res;
+}
+
+static int kurn_enabled(void) {
+    static int v = -1;
+    if (v < 0) v = getenv("GGML_KURN") != NULL;
+    return v;
+}
+
+static int64_t kurn_period(enum ggml_type t) {
+    switch (t) {
+        case GGML_TYPE_Q4_K: case GGML_TYPE_TQ2_0: return 256;
+        case GGML_TYPE_Q1_0: return 128;
+        case GGML_TYPE_Q2_0: return 64;
+        case GGML_TYPE_NVFP4: return 64;
+        default: return 32;
+    }
+}
+
+// Returns true if kurn computed this MUL_MAT (every thread calls it and does its own rows).
+static bool kurn_mul_mat(const struct ggml_compute_params * params, struct ggml_tensor * dst, const void * wdata) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    if (!kurn_enabled()) return false;
+    const kurn_kernel * k = NULL;
+    for (size_t i = 0; i < sizeof kurn_kernels / sizeof kurn_kernels[0]; i++)
+        if (kurn_kernels[i].type == (int) src0->type) k = &kurn_kernels[i];
+    if (k == NULL) return false;
+    const int64_t K = src0->ne[0], N = src0->ne[1], M = src1->ne[1];
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || M < 1 || M > 8 ||
+        !ggml_is_contiguous(src0) || !ggml_is_contiguous(dst) || dst->nb[0] != sizeof(float) || K > 32768 ||
+        K % kurn_period(src0->type) != 0) {
+        return false;
+    }
+    const int ith = params->ith, nth = params->nth;
+    const int64_t per = ((N + nth - 1) / nth + k->row_align - 1) / k->row_align * k->row_align;
+    const int64_t r0 = MIN(ith * per, N), r1 = MIN(r0 + per, N);
+    if (M == 1) {
+        void * pk = kurn_get_packed(src0, 0, k->gemv_prep);
+        if (r0 < r1) k->gemv(pk, wdata, (float *) dst->data, K, r0, r1);
+    } else {
+        const int ci = M <= 2 ? 0 : M <= 4 ? 1 : 2;
+        void * pk = k->shared ? kurn_get_packed(src0, 0, k->gemv_prep) : kurn_get_packed(src0, 1, k->vfy_prep);
+        if (r0 < r1) k->vfy[ci](pk, wdata, (float *) dst->data, K, N, M, r0, r1);
+    }
+    (void) kurn_vfy_cols;
+    return true;
+}
